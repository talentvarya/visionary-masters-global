# Supabase project settings (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key — server-side only, NEVER expose to the browser.
# Used only by admin server actions if/when needed.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: LinkedIn auto-post (see README "LinkedIn auto-post setup").
# Leave blank to disable — the admin's "Also post to LinkedIn" checkbox will
# just show an error if these aren't set.
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_URN=
